/* Slime TUI theme */

Screen {
    background: $surface;
}

Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $panel;
}

/* --------------------------------------------------------------- dashboard */

#dashboard-title {
    height: 1;
    padding: 1 2 0 2;
    text-style: bold;
    color: $accent;
}

#servers {
    height: 1fr;
    margin: 1 2;
    border: round $primary;
}

#dashboard-buttons {
    height: auto;
    padding: 0 2;
}

#dashboard-buttons Button {
    margin-right: 1;
}

#dashboard-status {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

/* ------------------------------------------------------------------ server */

#server-body {
    height: 1fr;
    padding: 1 2;
}

#server-title {
    height: 1;
    text-style: bold;
    color: $accent;
}

#server-status {
    height: 1;
    margin-bottom: 1;
}

#server-buttons {
    height: auto;
    margin-bottom: 1;
}

#server-buttons Button {
    margin-right: 1;
}

#console {
    height: 1fr;
    border: round $primary;
    background: $panel;
    padding: 0 1;
}

#command {
    height: 3;
    margin-top: 1;
}

/* ------------------------------------------------------------------- java */

#java-body,
#doctor-body {
    height: 1fr;
    padding: 1 2;
}

#java-title,
#doctor-title {
    height: 1;
    text-style: bold;
    color: $accent;
}

#java-table,
#checks-table {
    height: 1fr;
    border: round $primary;
}

#java-controls,
#doctor-controls {
    height: auto;
    padding: 1 0;
}

#java-controls Select {
    width: 32;
    margin-right: 1;
}

#java-controls Button,
#doctor-controls Button {
    margin-right: 1;
}

#java-status,
#doctor-summary {
    height: auto;
    min-height: 1;
    color: $text-muted;
}

/* ----------------------------------------------------------------- modals */

CreateServerScreen,
ConfirmScreen {
    align: center middle;
    background: $background 60%;
}

#create-dialog {
    width: 78;
    max-height: 92%;
    overflow-y: auto;
    padding: 1 2;
    border: thick $primary;
    background: $panel;
}

.dialog-title {
    height: 1;
    text-style: bold;
    color: $accent;
}

.dialog-subtitle {
    margin-bottom: 1;
    color: $text-muted;
}

CreateServerScreen Label {
    margin-top: 1;
}

CreateServerScreen Input,
CreateServerScreen Select {
    width: 100%;
}

.field-row {
    height: auto;
}

.field {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.field Label {
    margin-top: 0;
}

.switch-row {
    height: auto;
    margin-top: 1;
}

.hint {
    color: $text-muted;
}

#create-status {
    min-height: 1;
    margin-top: 1;
    color: $warning;
}

#create-buttons {
    height: auto;
    margin-top: 1;
}

#create-buttons Button {
    margin-right: 1;
}

#confirm-dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $panel;
}

#confirm-message {
    margin-bottom: 1;
}

#confirm-buttons {
    height: auto;
}

#confirm-buttons Button {
    margin-right: 1;
}
